<!DOCTYPE html>
<html>
<head>
  <title>Quan ly san pham</title>
  <style>
    body { font-family: Arial; margin: 40px; }
    table { border-collapse: collapse; width: 70%; margin: 0 auto 40px; }
    th, td { border: 1px solid #ccc; padding: 10px; text-align: left; }
    th { background-color: #2c3e50; color: white; }
    tr:nth-child(even) { background-color: #f2f2f2; }
    form { background: #f2f2f2; padding: 20px; border-radius: 8px; width: 320px; margin: 0 auto; }
    input { width: 100%; padding: 8px; margin-bottom: 10px; box-sizing: border-box; }
    button { width: 100%; padding: 10px; background: #2c3e50; color: white; border: none; border-radius: 4px; cursor: pointer; }
  </style>
</head>
<body>
  <h1 style="text-align:center;">Danh sach san pham</h1>
  <table>
    <tr>
      <th>ID</th><th>Ten san pham</th><th>Gia</th><th>Ton kho</th><th>Danh muc</th>
    </tr>
    <% sanpham.forEach(function(sp) { %>
    <tr>
      <td><%= sp.id %></td>
      <td><%= sp.ten_sp %></td>
      <td><%= sp.gia %></td>
      <td><%= sp.so_luong_ton %></td>
      <td><%= sp.danh_muc %></td>
    </tr>
    <% }); %>
  </table>

  <h2 style="text-align:center;">Them san pham moi</h2>
  <form action="/sanpham" method="POST">
    <input type="text" name="ten_sp" placeholder="Ten san pham" required>
    <input type="number" name="gia" placeholder="Gia (VND)" required>
    <input type="number" name="so_luong_ton" placeholder="So luong ton" required>
    <input type="text" name="danh_muc" placeholder="Danh muc" required>
    <button type="submit">Them san pham</button>
  </form>
</body>
</html>