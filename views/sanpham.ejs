<%- include('partials/header', { title: 'San pham' }) %>

<div class="page-container">

  <h1 class="page-title">Danh sach san pham</h1>

  <form action="/sanpham" method="GET" class="search-bar">
    <input type="text" name="search" placeholder="Tim kiem san pham..." value="<%= tuKhoa %>">
    <button type="submit">Tim</button>
  </form>

  <%
    function mauDanhMuc(danhMuc) {
      const mauSac = {
        'Phu kien': { bg: '#e0f2fe', text: '#0369a1' },
        'Phu kiện': { bg: '#e0f2fe', text: '#0369a1' },
        'Do trang tri': { bg: '#fce7f3', text: '#be185d' },
        'Đồ trang trí': { bg: '#fce7f3', text: '#be185d' },
        'Do gia dung': { bg: '#fef3c7', text: '#92400e' },
        'Đồ gia dụng': { bg: '#fef3c7', text: '#92400e' },
        'Do dien tu': { bg: '#ede9fe', text: '#5b21b6' },
        'Đồ điện tử': { bg: '#ede9fe', text: '#5b21b6' },
        'Đồ dùng cá nhân': { bg: '#dcfce7', text: '#166534' }
      };
      return mauSac[danhMuc] || { bg: '#f1f5f9', text: '#475569' };
    }
  %>

  <div class="product-grid">
    <% sanpham.forEach(function(sp) {
      const mau = mauDanhMuc(sp.danh_muc);
    %>
    <div class="product-card">
      <div class="product-image" style="background: <%= mau.text %>;">
        <%= sp.ten_sp.charAt(0).toUpperCase() %>
      </div>
      <div class="product-info">
        <div class="product-name"><a href="/sanpham/<%= sp.id %>"><%= sp.ten_sp %></a></div>
        <div class="product-price"><%= Number(sp.gia).toLocaleString('vi-VN') %>đ</div>
        <% if (currentUser.vai_tro === 'admin') { %><a href="/admin/sanpham/<%= sp.id %>/sua">Sửa sản phẩm</a><% } %>
        <div class="product-stock">Ton kho: <%= sp.so_luong_ton %></div>
        <form action="/giohang/them" method="POST">
          <input type="hidden" name="_csrf" value="<%= cartCsrf %>">
          <input type="hidden" name="id" value="<%= sp.id %>">
          <input type="hidden" name="qty" value="1">
          <button type="submit" <%= sp.so_luong_ton > 0 ? '' : 'disabled' %>>Thêm vào giỏ</button>
        </form>
        <span class="category-badge" style="background: <%= mau.bg %>; color: <%= mau.text %>;">
          <%= sp.danh_muc %>
        </span>
      </div>
    </div>
    <% }); %>
  </div>

  <% if (currentUser && currentUser.vai_tro === 'admin') { %>
  <div class="card">
    <h2>Thêm sản phẩm</h2>
    <form action="/sanpham" method="POST">
      <input name="ten_sp" placeholder="Tên sản phẩm" maxlength="150" required>
      <input name="gia" type="number" min="0" max="2147483647" step="1" placeholder="Giá (đ)" required>
      <input name="so_luong_ton" type="number" min="0" max="2147483647" step="1" placeholder="Tồn kho" required>
      <input name="danh_muc" maxlength="100" placeholder="Danh mục">
      <input name="thuong_hieu" maxlength="100" placeholder="Thương hiệu">
      <input name="tu_khoa" maxlength="500" placeholder="Từ khóa, ví dụ: bluetooth pin game">
      <textarea name="mo_ta" maxlength="10000" placeholder="Mô tả"></textarea>
      <button type="submit">Thêm sản phẩm</button>
    </form>
    <h2>Nhap san pham so luong lon</h2>
    <form action="/import-sanpham" method="POST" enctype="multipart/form-data">
      <input type="file" name="file" accept=".xlsx,.xls" required>
      <button type="submit">Import</button>
    </form>
  </div>
  <% } %>

</div>

<%- include('partials/footer') %>