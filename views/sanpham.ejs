<!DOCTYPE html>
<html>
<head>
  <title>Danh sach san pham</title>
  <style>
    table { border-collapse: collapse; width: 70%; margin: 40px auto; font-family: Arial; }
    th, td { border: 1px solid #ccc; padding: 10px; text-align: left; }
    th { background-color: #2c3e50; color: white; }
    tr:nth-child(even) { background-color: #f2f2f2; }
  </style>
</head>
<body>
  <h1 style="text-align:center;">Danh sach san pham</h1>
  <table>
    <tr>
      <th>ID</th>
      <th>Ten san pham</th>
      <th>Gia</th>
      <th>Ton kho</th>
      <th>Danh muc</th>
    </tr>
    <% sanpham.forEach(function(sp) { %>
    <tr>
      <td><%= sp.id %></td>
      <td><%= sp.ten_sp %></td>
      <td><%= sp.gia %></td>
      <td><%= sp.so_luong_ton %></td>
      <td><%= sp.danh_muc %></td>
    </tr>
    <% }); %>
  </table>
</body>
</html>