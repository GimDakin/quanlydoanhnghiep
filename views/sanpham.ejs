<!DOCTYPE html>
<html>
<head>
  <title>Quan ly san pham</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="page-container">
    <h1 class="page-title">Danh sach san pham</h1>
    <table>
      <tr>
        <th>ID</th><th>Ten san pham</th><th>Gia</th><th>Ton kho</th><th>Danh muc</th>
      </tr>
      <% sanpham.forEach(function(sp) { %>
      <tr>
        <td><%= sp.id %></td>
        <td><%= sp.ten_sp %></td>
        <td><%= sp.gia %></td>
        <td><%= sp.so_luong_ton %></td>
        <td><%= sp.danh_muc %></td>
      </tr>
      <% }); %>
    </table>

    <div class="card">
      <h2>Import san pham tu Excel</h2>
      <form action="/import-sanpham" method="POST" enctype="multipart/form-data">
        <input type="file" name="file" accept=".xlsx,.xls" required>
        <button type="submit">Import Excel</button>
      </form>
    </div>
  </div>
</body>
</html>